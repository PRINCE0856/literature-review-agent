# =====================================================================
# Literature Review Agent - environment template
#
# Copy this file to `.env` and fill in only what you have. The pipeline runs
# with NONE of these set: Crossref, OpenAlex, Semantic Scholar, Europe PMC,
# arXiv, and Unpaywall all work without credentials.
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys, and never paste key contents
# into a chat window.
# =====================================================================

# ---------------------------------------------------------------------
# Contact email  (RECOMMENDED - not a secret)
# ---------------------------------------------------------------------
# Crossref, OpenAlex, and Unpaywall ask API users to identify themselves.
# Supplying a real address gets you the faster "polite pool" and is required
# by Unpaywall. Use your institutional address.
LITERATURE_REVIEW_CONTACT_EMAIL=you@your-institution.org


# ---------------------------------------------------------------------
# Google Drive  (REQUIRED for output storage)
# ---------------------------------------------------------------------
# All review outputs are stored in Google Drive; local folders are staging only.
# These variables hold FILE PATHS, never credential contents.

# Master switch. Set to false to run entirely locally with no uploads.
GOOGLE_DRIVE_ENABLED=true

# --- OAuth (default: your own Google account, interactive once) ---
# 1. Google Cloud Console > create/open a project > enable the Google Drive API.
# 2. APIs & Services > Credentials > Create credentials > OAuth client ID.
# 3. Application type: "Desktop app". Download the JSON.
# 4. Save it at the path below (the `secrets/` folder is git-ignored).
# 5. Run once:  python -m literature_review_agent drive-login
GOOGLE_DRIVE_CREDENTIALS_FILE=secrets/credentials.json

# Where the cached OAuth token is written after you authorise. Never commit it.
GOOGLE_DRIVE_TOKEN_FILE=secrets/token.json

# --- Service account (alternative: headless runs and Shared Drives) ---
# Set drive.auth_method to `service_account` in config/google_drive.yaml, then:
# 1. Create a service account and a JSON key for it.
# 2. Save the key at the path below.
# 3. Share your target Drive folder with the service account's email address,
#    granting "Content manager" (Shared Drive) or "Editor" (My Drive).
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json

# --- Destination ---
# For a Shared Drive (Team Drive): set drive.location to `shared_drive` in
# config/google_drive.yaml and put the Drive ID here. The ID is the last path
# segment of drive.google.com/drive/folders/<ID>.
GOOGLE_SHARED_DRIVE_ID=

# Optional: pin uploads to an existing Drive folder by ID instead of creating
# a folder named "Literature Review". Leave blank to let the agent create it.
GOOGLE_DRIVE_ROOT_FOLDER_ID=


# ---------------------------------------------------------------------
# Optional scholarly API keys
# ---------------------------------------------------------------------
# Each source is skipped automatically when its key is absent. Nothing below
# is required.

# Semantic Scholar: free key, raises the rate limit considerably.
# Request at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex premium key (the free tier needs no key).
OPENALEX_API_KEY=

# CORE: open-access repository aggregator. Register at https://core.ac.uk/services/api
CORE_API_KEY=

# Elsevier (Scopus / ScienceDirect). Register at https://dev.elsevier.com
# Metadata search only. Full text is retrieved solely for open-access records;
# subscription content must be obtained through your own institutional access.
ELSEVIER_API_KEY=
# Institutional token, if your library issued one.
ELSEVIER_INSTTOKEN=

# Springer Nature. Register at https://dev.springernature.com
SPRINGER_API_KEY=


# ---------------------------------------------------------------------
# Optional Claude assistance
# ---------------------------------------------------------------------
# Without this key the pipeline still runs: keyword expansion and paper
# analysis fall back to their deterministic implementations. With it, Claude
# enriches keyword sets and paper analysis. It never invents evidence.
ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------
# Force the project root (normally detected automatically).
# LITERATURE_REVIEW_ROOT=/absolute/path/to/Literature Review
